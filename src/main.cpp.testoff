#include <Arduino.h>
#include <math.h>

constexpr uint8_t kDacX = 25;
constexpr uint8_t kDacY = 26;
constexpr uint16_t kSamples = 256;
constexpr uint16_t kSampleDelayUs = 40;

uint8_t waveform[kSamples];

void setup() {
  for (uint16_t sample = 0; sample < kSamples; ++sample) {
    const float angle = 2.0f * PI * sample / kSamples;
    waveform[sample] = static_cast<uint8_t>(127.5f + 127.5f * sinf(angle) + 0.5f);
  }
}

void loop() {
  for (uint16_t sample = 0; sample < kSamples; ++sample) {
    dacWrite(kDacX, waveform[sample]);
    dacWrite(kDacY, waveform[(sample + kSamples / 4) % kSamples]);
    delayMicroseconds(kSampleDelayUs);
  }
}